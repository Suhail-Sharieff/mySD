  <diagram name="ElevatorUML" id="elevator_clean_1">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" background="none" math="0" shadow="0">
      <root>
